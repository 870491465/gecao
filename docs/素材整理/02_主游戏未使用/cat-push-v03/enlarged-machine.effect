CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        machineTransform: { value: [1.5, 1.4, 270, 200] }
        outputCanvas: { value: [64, 128, 640, 896] }
        sourceSize: { value: [512, 768, 256, 0] }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;
  uniform MachineRegion { vec4 machineTransform; vec4 outputCanvas; vec4 sourceSize; };

  #if USE_TEXTURE
    in vec2 uv0;
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif

  vec4 frag () {
    vec4 o = vec4(1, 1, 1, 1);

    #if USE_TEXTURE
      // Only machine pixels above source y=270 are transformed.
      // The cat and gripping paws pass through at their exact source coordinates.
      vec2 pixel = uv0 * outputCanvas.zw - outputCanvas.xy;
      float pivotY = machineTransform.z;
      float taperY = machineTransform.w;
      if (pixel.y < pivotY) {
        float sourceY;
        float fullScaleEnd = pivotY + (taperY - pivotY) * machineTransform.y;
        if (pixel.y <= fullScaleEnd) {
          sourceY = pivotY + (pixel.y - pivotY) / machineTransform.y;
        } else {
          float lo = taperY;
          float hi = pivotY;
          for (int i = 0; i < 10; i++) {
            float mid = (lo + hi) * 0.5;
            float weight = 1.0 - smoothstep(taperY, pivotY, mid);
            float outputY = pivotY + (mid - pivotY) * (1.0 + (machineTransform.y - 1.0) * weight);
            if (outputY < pixel.y) lo = mid; else hi = mid;
          }
          sourceY = (lo + hi) * 0.5;
        }
        float weight = 1.0 - smoothstep(taperY, pivotY, sourceY);
        pixel.x = sourceSize.z + (pixel.x - sourceSize.z) / (1.0 + (machineTransform.x - 1.0) * weight);
        pixel.y = sourceY;
        // Wheels are rendered as rigid crops of these same original frames.
        // Avoid stretching the tires through the handle transition.
        if (pixel.y >= 167.0 && pixel.y <= 281.0 &&
            ((pixel.x >= 80.0 && pixel.x <= 138.0) || (pixel.x >= 382.0 && pixel.x <= 442.0))) discard;
      }
      vec2 sampleUV = pixel / sourceSize.xy;
      if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0) discard;
      o *= CCSampleWithAlphaSeparated(cc_spriteTexture, sampleUV);
      #if IS_GRAY
        float gray  = 0.2126 * o.r + 0.7152 * o.g + 0.0722 * o.b;
        o.r = o.g = o.b = gray;
      #endif
    #endif

    o *= color;
    ALPHA_TEST(o);
    return o;
  }
}%
